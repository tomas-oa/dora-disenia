{
  "name": "dorila-morila",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro preview",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" astro.config.mjs wrangler.jsonc package.json tsconfig.json",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" astro.config.mjs wrangler.jsonc package.json tsconfig.json",
    "deploy": "wrangler types && astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/preact": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "astro": "^7.2.7",
    "clsx": "^2.1.1",
    "preact": "^10.27.2",
    "resend": "^6.22.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.126.0"
  },
  "packageManager": "bun@1.4.0"
}
