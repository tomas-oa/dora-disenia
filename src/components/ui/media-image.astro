---
import type { ProjectMedia } from "@/src/lib/cms/types";

interface Props {
  media?: ProjectMedia;
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
}

const {
  media,
  src: sourceProp,
  alt: altProp,
  width: widthProp,
  height: heightProp,
  class: className,
  loading = "lazy",
  priority = false,
} = Astro.props;

const source = media?.src ?? sourceProp;
if (!source) throw new Error("MediaImage requires a source");

const alt = altProp ?? media?.alt ?? "";
const width = widthProp ?? media?.width;
const height = heightProp ?? media?.height;
const imageLoading = priority ? "eager" : loading;
---

<img
  src={source}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={imageLoading}
  decoding={priority ? "sync" : "async"}
  draggable="false"
/>
