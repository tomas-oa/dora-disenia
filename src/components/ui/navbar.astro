---
import { clsx } from "clsx";


interface Props {
  showLogo?: boolean;
  hrefBase?: string;
}

const { showLogo = true, hrefBase = "" } = Astro.props;
---

<nav
  class={clsx(
    "hidden",
    "md:fixed md:top-0 md:inset-x-0 md:z-50",
    "md:bg-black md:flex md:flex-row md:justify-between md:w-full",
    "md:py-4 md:px-navbar",
  )}
>
  <a class={clsx(!showLogo && "invisible")} href={`${hrefBase}/`}>
    <img draggable="false" src="/media/ui/navbar/logo_dora.svg" alt="dora logo" width="271" height="64" class="invert w-22" />
  </a>

  <article class="flex flex-row gap-12 md:gap-28 text-dora-white">
    <a href={`${hrefBase}/#proyectos`}>Proyectos</a>
    <a href={`${hrefBase}/#contacto`}>Contacto</a>
    <a download href={`${hrefBase}/media/cv.pdf`}>CV <span class="inline-block">↓</span></a>
  </article>
</nav>
