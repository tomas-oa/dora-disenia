---
import { BASE_URL } from "@/src/lib/site";
import Layout from "@/src/layouts/layout.astro";
import { getProjectById, getTags } from "@/src/lib/cms/data";
import { ADMIN_HOST } from "@/src/lib/cms/hosts";
import {
  MEDIA_PRESENTATION_OPTIONS,
  PROJECT_COLOR_OPTIONS,
  type ProjectMedia,
} from "@/src/lib/cms/types";
import { env } from "cloudflare:workers";

const project = await getProjectById(env, Astro.params.id ?? "");
const tags = await getTags(env);
if (!project) Astro.response.status = 404;
const mediaItems: ProjectMedia[] = project
  ? [...(project.storage.coverMedia ? [project.storage.coverMedia] : []), ...project.storage.images]
  : [];
const selectedTagKeys = new Set(project?.tags.map((tag) => tag.key));
const adminPath = Astro.url.hostname === ADMIN_HOST ? "" : "/admin";
const apiPath = Astro.url.hostname === ADMIN_HOST ? "/api" : "/api/admin";
const publicProjectUrl = project ? new URL(`/proyectos/${project.slug}`, BASE_URL).toString() : "/";
const selectedColorClass = project && PROJECT_COLOR_OPTIONS.some((option) => option.value === project.color)
  ? project.color
  : "bg-dora-white";
---

<Layout title={project ? `Editar ${project.title}` : "Proyecto no encontrado"} noIndex>
  {project ? (
    <main class="mx-auto flex min-h-svh w-full max-w-4xl flex-col gap-8 p-container">
      <header class="flex items-center justify-between gap-4 border-b border-black pb-4">
        <a href={`${adminPath}/`} class="underline">← Editor</a>
        <a href={`${adminPath}/preview/${project.slug}`} target="_blank" rel="noreferrer" class="underline">Vista previa ↗</a>
      </header>

      <form id="project-editor" class="flex flex-col gap-6">
        <section class="flex flex-col gap-4">
          <div>
            <h1 class="font-display text-4xl">Editar proyecto</h1>
            <p class="mt-1 text-sm">Los cambios se reflejan en el portafolio al guardar.</p>
          </div>
          <label class="flex flex-col gap-0.5">Título<input name="title" required value={project.title} class="input" /></label>
          <label class="flex flex-col gap-0.5">Dirección web<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" value={project.slug} class="input" /><span class="text-xs">Solo minúsculas, números y guiones.</span></label>
          <label class="flex flex-col gap-0.5">Color del proyecto<div class="relative"><span id="project-color-swatch" class={`${selectedColorClass} pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 rounded-full border border-black/20`} aria-hidden="true"></span><select name="colorClass" data-color-select class={`input w-full pl-10 ${selectedColorClass}`}><option value="" disabled>Elige un color</option>{PROJECT_COLOR_OPTIONS.map((option) => <option value={option.value} class={option.value} selected={project.color === option.value}>{option.label}</option>)}</select></div><span class="text-xs">Se usa como color de fondo en la portada del proyecto.</span></label>
          <label class="flex flex-col gap-0.5">Descripción corta<textarea name="digest" rows="3" class="input resize-none">{project.content.diggest}</textarea><span class="text-xs">Aparece junto al título.</span></label>
          <label class="flex flex-col gap-0.5">Descripción completa<textarea name="summary" rows="9" class="input resize-none">{project.content.summary}</textarea><span class="text-xs">Aparece en la sección de resumen.</span></label>
          <label class="flex flex-col gap-0.5">Estado de publicación<select name="status" class="input"><option value="draft" selected={!project.published}>Borrador — solo visible en vista previa</option><option value="published" selected={project.published}>Publicado — visible en el portafolio</option></select></label>
        </section>

        <fieldset class="flex flex-col gap-3 border border-black p-4">
          <legend class="px-1 font-display">Categorías</legend>
          <p class="text-sm">Elige las categorías que describen este proyecto.</p>
          <div class="grid gap-2 sm:grid-cols-2">
            {tags.map((tag) => <label class="flex items-center gap-2 rounded-sm border border-zinc-300 p-3 transition hover:border-zinc-400"><input type="checkbox" name="tags" value={tag.key} checked={selectedTagKeys.has(tag.key)} /><span>{tag.label}</span></label>)}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-4 border border-black p-4">
          <legend class="px-1 font-display">Imágenes y videos</legend>
          <p class="text-sm">Arrastra una pieza para cambiar el orden. También puedes usar los botones subir y bajar. Los cambios se aplican al guardar.</p>
          <div id="media-list" class="flex flex-col gap-3">
            {mediaItems.map((item) => <article draggable="true" data-media-card data-media-id={item.id} data-media-type={item.mediaType} data-media-src={item.src} data-object-key={item.objectKey} data-public-url={item.publicUrl} data-mime-type={item.mimeType ?? ""} data-size-bytes={item.sizeBytes ?? ""} data-width={item.width ?? ""} data-height={item.height ?? ""} class="flex gap-3 border border-black p-3"><button type="button" data-drag-handle class="cursor-grab self-start text-xl leading-none" aria-label="Arrastrar para reordenar">⠿</button><div class="size-24 shrink-0 overflow-hidden border border-black bg-black">{item.mediaType === "video" ? <video src={item.publicUrl} muted playsinline preload="metadata" class="size-full object-cover" /> : <img src={item.publicUrl} alt="" class="size-full object-cover" loading="lazy" />}</div><div class="flex min-w-0 flex-1 flex-col gap-3"><div class="flex flex-wrap gap-3"><label class="flex min-w-36 flex-1 flex-col gap-0.5">Uso<select data-media-field="role" class="input"><option value="gallery" selected={item.role === "gallery"}>Galería</option><option value="cover" selected={item.role === "cover"}>Portada</option></select></label><label class="flex min-w-48 flex-1 flex-col gap-0.5">Presentación<select data-media-field="className" class="input">{MEDIA_PRESENTATION_OPTIONS.map((option) => <option value={option.value} selected={item.className === option.value}>{option.label}</option>)}</select></label></div><label class="flex flex-col gap-0.5">Texto alternativo<input data-media-field="alt" value={item.alt} class="input" /><span class="text-xs">Describe la pieza para personas que usan lector de pantalla.</span></label><div class="flex flex-wrap items-center gap-3 text-sm"><button type="button" data-move="up" class="underline">Subir</button><button type="button" data-move="down" class="underline">Bajar</button><button type="button" data-remove-media class="ml-auto text-red-700 underline">Quitar</button></div></div></article>)}
          </div>
          <div class="border-t border-black pt-4">
            <h2 class="font-display text-xl">Añadir una pieza</h2>
            <p class="mt-1 text-sm">Sube una imagen o video nuevo. Después podrás editarlo arriba.</p>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="flex flex-col gap-0.5">Archivo<input id="media-file" type="file" accept="image/*,video/*" class="input" /></label>
              <label class="flex flex-col gap-0.5">Uso<select id="media-role" class="input"><option value="gallery">Galería</option><option value="cover">Portada</option></select></label>
              <label class="flex flex-col gap-0.5">Presentación<select id="media-class" class="input">{MEDIA_PRESENTATION_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
              <label class="flex flex-col gap-0.5">Texto alternativo<input id="media-alt" value={project.title} class="input" /></label>
            </div>
            <button id="upload-media" type="button" class="mt-4 rounded-full border border-black px-5 py-2">Añadir archivo</button>
            <output id="upload-status" class="mt-2 block text-sm" aria-live="polite"></output>
          </div>
        </fieldset>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-black pt-5"><a href={publicProjectUrl} class="underline">Abrir versión pública</a><button class="rounded-full bg-black px-6 py-3 text-white" type="submit">Guardar cambios</button></div>
        <output id="save-status" class="text-sm" aria-live="polite"></output>
      </form>
    </main>
  ) : <main class="p-container"><h1 class="font-display text-5xl">Proyecto no encontrado</h1></main>}
</Layout>

<script define:vars={{ projectId: Astro.params.id, apiPath, tagOptions: tags, colorOptions: PROJECT_COLOR_OPTIONS.map((option) => option.value) }}>
  const form = document.querySelector("#project-editor");
  const mediaList = document.querySelector("#media-list");
  const status = document.querySelector("#save-status");
  const uploadButton = document.querySelector("#upload-media");
  const uploadStatus = document.querySelector("#upload-status");
  const colorSelect = document.querySelector("[data-color-select]");
  const colorSwatch = document.querySelector("#project-color-swatch");

  colorSelect?.addEventListener("change", () => {
    if (!(colorSelect instanceof HTMLSelectElement) || !(colorSwatch instanceof HTMLElement)) return;
    colorSelect.classList.remove(...colorOptions);
    colorSwatch.classList.remove(...colorOptions);
    if (!colorOptions.includes(colorSelect.value)) return;
    colorSelect.classList.add(colorSelect.value);
    colorSwatch.classList.add(colorSelect.value);
  });

  const escapeHtml = (value) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character]);
  const presentationOptions = [
    ["", "Predeterminado"],
    ["object-top", "Encuadre arriba"],
    ["object-center", "Encuadre centro"],
    ["object-bottom", "Encuadre abajo"],
    ["scale-120", "Ampliar 120%"],
    ["scale-140", "Ampliar 140%"],
  ];

  const createMediaCard = (item) => {
    const card = document.createElement("article");
    const preview = item.mediaType === "video"
      ? `<video src="${escapeHtml(item.publicUrl)}" muted playsinline preload="metadata" class="size-full object-cover"></video>`
      : `<img src="${escapeHtml(item.publicUrl)}" alt="" class="size-full object-cover" loading="lazy">`;
    const roleOptions = `<option value="gallery"${item.role === "gallery" ? " selected" : ""}>Galería</option><option value="cover"${item.role === "cover" ? " selected" : ""}>Portada</option>`;
    const classOptions = presentationOptions.map(([value, label]) => `<option value="${value}"${value === item.className ? " selected" : ""}>${label}</option>`).join("");
    card.draggable = true;
    card.dataset.mediaCard = "true";
    card.dataset.mediaId = item.id;
    card.dataset.mediaType = item.mediaType;
    card.dataset.mediaSrc = item.src;
    card.dataset.objectKey = item.objectKey;
    card.dataset.publicUrl = item.publicUrl;
    card.dataset.mimeType = item.mimeType ?? "";
    card.dataset.sizeBytes = item.sizeBytes ?? "";
    card.dataset.width = item.width ?? "";
    card.dataset.height = item.height ?? "";
    card.className = "flex gap-3 border border-black p-3";
    card.innerHTML = `<button type="button" data-drag-handle class="cursor-grab self-start text-xl leading-none" aria-label="Arrastrar para reordenar">⠿</button><div class="size-24 shrink-0 overflow-hidden border border-black bg-black">${preview}</div><div class="flex min-w-0 flex-1 flex-col gap-3"><div class="flex flex-wrap gap-3"><label class="flex min-w-36 flex-1 flex-col gap-0.5">Uso<select data-media-field="role" class="input">${roleOptions}</select></label><label class="flex min-w-48 flex-1 flex-col gap-0.5">Presentación<select data-media-field="className" class="input">${classOptions}</select></label></div><label class="flex flex-col gap-0.5">Texto alternativo<input data-media-field="alt" value="${escapeHtml(item.alt)}" class="input"><span class="text-xs">Describe la pieza para personas que usan lector de pantalla.</span></label><div class="flex flex-wrap items-center gap-3 text-sm"><button type="button" data-move="up" class="underline">Subir</button><button type="button" data-move="down" class="underline">Bajar</button><button type="button" data-remove-media class="ml-auto text-red-700 underline">Quitar</button></div></div>`;
    return card;
  };

  const demoteOtherCovers = (selectedCard) => {
    mediaList?.querySelectorAll("[data-media-card]").forEach((card) => {
      if (card === selectedCard) return;
      const roleField = card.querySelector('[data-media-field="role"]');
      if (roleField instanceof HTMLSelectElement) roleField.value = "gallery";
    });
  };

  const readMedia = () => [...(mediaList?.querySelectorAll("[data-media-card]") ?? [])].map((card, sortOrder) => {
    const field = (name) => card.querySelector(`[data-media-field="${name}"]`);
    return {
      id: card.dataset.mediaId,
      src: card.dataset.mediaSrc,
      alt: field("alt")?.value.trim() ?? "",
      className: field("className")?.value ?? "",
      mediaType: card.dataset.mediaType,
      role: field("role")?.value ?? "gallery",
      sortOrder,
      objectKey: card.dataset.objectKey,
      publicUrl: card.dataset.publicUrl,
      mimeType: card.dataset.mimeType || null,
      sizeBytes: card.dataset.sizeBytes ? Number(card.dataset.sizeBytes) : null,
      width: card.dataset.width ? Number(card.dataset.width) : null,
      height: card.dataset.height ? Number(card.dataset.height) : null,
    };
  });

  let draggedCard;
  mediaList?.addEventListener("dragstart", (event) => {
    const card = event.target.closest("[data-media-card]");
    if (!(card instanceof HTMLElement)) return;
    draggedCard = card;
    card.classList.add("opacity-50");
  });
  mediaList?.addEventListener("dragend", () => {
    draggedCard?.classList.remove("opacity-50");
    draggedCard = undefined;
  });
  mediaList?.addEventListener("dragover", (event) => {
    event.preventDefault();
    const target = event.target.closest("[data-media-card]");
    if (!(target instanceof HTMLElement) || !draggedCard || target === draggedCard) return;
    const after = event.clientY > target.getBoundingClientRect().top + target.offsetHeight / 2;
    mediaList.insertBefore(draggedCard, after ? target.nextSibling : target);
  });
  mediaList?.addEventListener("change", (event) => {
    const field = event.target;
    if (!(field instanceof HTMLSelectElement) || field.dataset.mediaField !== "role" || field.value !== "cover") return;
    demoteOtherCovers(field.closest("[data-media-card]"));
  });
  mediaList?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const card = target.closest("[data-media-card]");
    if (!(card instanceof HTMLElement)) return;
    if (target.hasAttribute("data-remove-media")) {
      card.remove();
      if (uploadStatus) uploadStatus.textContent = "Pieza retirada. Guarda los cambios para confirmar.";
      return;
    }
    if (target.dataset.move === "up" && card.previousElementSibling) mediaList.insertBefore(card, card.previousElementSibling);
    if (target.dataset.move === "down" && card.nextElementSibling) mediaList.insertBefore(card, card.nextElementSibling.nextElementSibling);
  });

  uploadButton?.addEventListener("click", async () => {
    if (!(uploadStatus instanceof HTMLOutputElement)) return;
    const fileInput = document.querySelector("#media-file");
    if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) {
      uploadStatus.textContent = "Elige un archivo primero.";
      return;
    }
    const file = fileInput.files[0];
    const role = document.querySelector("#media-role")?.value === "cover" ? "cover" : "gallery";
    const className = document.querySelector("#media-class")?.value ?? "";
    const alt = document.querySelector("#media-alt")?.value.trim() ?? "";
    const data = new FormData();
    data.append("file", file);
    data.append("projectId", String(projectId));
    data.append("role", role);
    data.append("className", className);
    data.append("alt", alt);
    uploadStatus.textContent = "Subiendo…";
    try {
      const response = await fetch(`${apiPath}/media`, { method: "POST", body: data });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      const card = createMediaCard({ id: result.id, src: result.publicUrl, alt, className, mediaType: result.mediaType, role, objectKey: result.objectKey, publicUrl: result.publicUrl, mimeType: file.type, sizeBytes: file.size, width: null, height: null });
      if (role === "cover") demoteOtherCovers(card);
      mediaList?.append(card);
      uploadStatus.textContent = "Archivo añadido. Revisa sus datos y guarda los cambios.";
      fileInput.value = "";
    } catch (error) {
      uploadStatus.textContent = error instanceof Error ? error.message : "No se pudo subir el archivo.";
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLOutputElement)) return;
    const data = new FormData(form);
    const tags = data.getAll("tags").map((key) => tagOptions.find((tag) => tag.key === key)).filter(Boolean);
    const media = readMedia();
    if (media.filter((item) => item.role === "cover").length !== 1) {
      status.textContent = "Elige exactamente una pieza como portada.";
      return;
    }
    status.textContent = "Guardando…";
    try {
      const body = { title: data.get("title"), slug: data.get("slug"), colorClass: data.get("colorClass"), digest: data.get("digest"), summary: data.get("summary"), status: data.get("status"), tags, media };
      const response = await fetch(`${apiPath}/projects/${projectId}`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      status.textContent = "Cambios guardados.";
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "No se pudo guardar.";
    }
  });
</script>
