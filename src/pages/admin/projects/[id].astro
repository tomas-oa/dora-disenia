---
import { BASE_URL } from "@/src/lib/site";
import ProjectEditor from "@/src/components/admin/project-editor";
import Layout from "@/src/layouts/layout.astro";
import { getProjectById, getTags } from "@/src/lib/cms/data";
import { ADMIN_HOST } from "@/src/lib/cms/hosts";
import { env } from "cloudflare:workers";

const projectId = Astro.params.id!;
const project = await getProjectById(env, projectId);
const tags = await getTags(env);
if (!project) Astro.response.status = 404;
const adminPath = Astro.url.hostname === ADMIN_HOST ? "" : "/admin";
const apiPath = Astro.url.hostname === ADMIN_HOST ? "/api" : "/api/admin";
const publicProjectUrl = project ? new URL(`/proyectos/${project.slug}`, BASE_URL).toString() : "/";
---

<Layout title={project ? `Editar ${project.title}` : "Proyecto no encontrado"} noIndex>
  {project ? (
    <main class="mx-auto flex min-h-svh w-full max-w-4xl flex-col gap-8 p-container">
      <header class="flex items-center justify-between gap-4 border-b border-black pb-4">
        <a href={`${adminPath}/`} class="underline">← Editor</a>
        <a href={`${adminPath}/preview/${project.slug}`} target="_blank" rel="noreferrer" class="underline">Vista previa ↗</a>
      </header>
      <ProjectEditor
        project={project}
        tags={tags}
        projectId={projectId}
        apiPath={apiPath}
        publicProjectUrl={publicProjectUrl}
        client:load
      />
    </main>
  ) : <main class="p-container"><h1 class="font-display text-5xl">Proyecto no encontrado</h1></main>}
</Layout>
