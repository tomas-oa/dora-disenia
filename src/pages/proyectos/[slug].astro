---
import Layout from "@/src/layouts/layout.astro";
import ProjectDetail from "@/src/components/projects/project-detail.astro";
import { getProjectBySlug } from "@/src/lib/cms/data";
import { env } from "cloudflare:workers";

export const prerender = false;

const project = await getProjectBySlug(env, Astro.params.slug!, false);
if (!project) Astro.response.status = 404;
---

{project ? (
  <Layout title={project.title} description={project.content.diggest}><ProjectDetail project={project} /></Layout>
) : (
  <Layout title="Página no encontrada">
    <main class="flex min-h-svh items-center justify-center p-container"><div class="text-center"><p class="font-display text-6xl">404</p><a class="underline" href="/">Volver al inicio</a></div></main>
  </Layout>
)}
