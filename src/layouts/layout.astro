---
import "@/src/styles/global.css";

import { Font } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";
import icon from "@/src/assets/ui/icon.svg";
import logoDesktop from "@/src/assets/ui/hero/logo_desktop.svg";
import { BASE_URL } from "@/src/lib/site";

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = "DORA DISEÑA",
  description = "Diseñadora con experiencia en diseño gráfico, editorial, branding e ilustración, egresada de la UC. Especialista en soluciones visuales efectivas.",
  noIndex = false,
} = Astro.props;

const pageTitle = title === "DORA DISEÑA" ? title : `${title} • DORA DISEÑA`;
const canonicalUrl = new URL(Astro.url.pathname, BASE_URL).toString();
const socialImageUrl = new URL(logoDesktop.src, BASE_URL).toString();
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={icon.src} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DORA DISEÑA" />
    <meta property="og:locale" content="es" />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={socialImageUrl}
    />
    <ClientRouter />
    <Font cssVariable="--font-coolvetica" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={socialImageUrl}
    />
    <title>{pageTitle}</title>
  </head>
  <body
    transition:animate={fade({ duration: "0.42s" })}
    class="flex min-h-svh flex-col selection:bg-fuchsia-300 selection:text-fuchsia-900 [&_main]:md:mt-8 [&_section]:scroll-mt-[57px] scroll-smooth bg-dora-white font-sans antialiased motion-reduce:scroll-auto"
  >
    <slot />
  </body>
</html>
